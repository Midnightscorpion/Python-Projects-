print(" - - - - - - - - - - - - - -  ")

# Function to create arrays
def create_array(arr):
    if ';' in arr:
        # Splitting dimension by semicolon and rows by comma
        rows = arr.split(';')
        array = []
        for row in rows:
            cr = [int(x) for x in row.split(',')]
            array.append(cr)  # Append each row regardless of length
        return np.array(array, dtype=object)  # Use dtype=object to allow variable-length rows
    else:
        return np.array([int(x) for x in arr.split(',')])

# Input arrays of your choice
a = create_array(input("Enter array A: "))
b = create_array(input("Enter array B: "))
c = create_array(input("Enter array C: "))
d = create_array(input("Enter array D: "))

